# --- Server ---
PORT=8080
NODE_ENV=development

# --- Auth ---
# Use a long, random string in every real environment. Never commit the real value.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# --- Black Box ledger ---
# HMAC key that seals the decision chain. Held only by the server, so a tampered
# record cannot be re-sealed without it. Falls back to JWT_SECRET if unset.
LEDGER_SECRET=replace-with-a-separate-long-random-secret

# --- Database ---
# SQLite file path (created automatically on first run)
DATABASE_PATH=./data/auditor-zero.db

# --- LLM (Anthropic) ---
# Required for semantic contradiction/disappearance detection.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxx-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- MCP ---
MCP_SERVER_NAME=auditor-zero
MCP_SERVER_VERSION=1.0.0

# --- Demo ---
# Allows the dev-only tamper endpoint even when NODE_ENV=production. Keep false in real deployments.
ALLOW_TAMPER_DEMO=false

# --- Deployment ---
# Filled in after deploying
SERVICE_URL=http://localhost:8080

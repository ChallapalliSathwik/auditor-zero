{
  "name": "auditor-zero",
  "version": "1.0.0",
  "description": "Auditor Zero + Black Box — AI document audit with cryptographically-sealed decision replay",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "npm run build:web && tsx watch src/server.ts",
    "mcp": "tsx src/mcp/server.ts",
    "build": "tsc -p tsconfig.json && npm run build:web",
    "build:web": "esbuild src/widgets/app/audit-results/page.tsx --bundle --outfile=public/audit-results.bundle.js --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\"",
    "start": "npm run build && node dist/server.js",
    "test": "vitest run",
    "seed": "tsx src/db/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "better-sqlite3": "^11.3.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^9.0.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.8",
    "esbuild": "^0.23.1",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
